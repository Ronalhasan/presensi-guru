# Salin file ini jadi .env.local untuk pengembangan lokal.
# Nilai sesungguhnya diisi di Vercel > Settings > Environment Variables.

# Dipakai di sisi SERVER (route.ts) — jangan pernah diekspos ke browser.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini

# Dipakai di sisi BROWSER (halaman guru/admin) — aman untuk diekspos.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-anon-public-key-di-sini
